# Copy to .env. Every value has a default; a token is the only thing worth setting.

# Public GitHub org to mirror.
GITHUB_ORG=tinygrad

# Used to list repos and members and to authenticate migration. Scopes: public_repo and read:org.
# If empty and the gh CLI is logged in, its token is used.
GITHUB_TOKEN=

# Cap on repos to migrate, newest-pushed first. 0 means all.
MAX_REPOS=0

# Gitea release to download, and the port it listens on.
GITEA_VERSION=1.22.6
GITEA_HTTP_PORT=3000

# Admin account created on first start.
GITEA_ADMIN_USER=fixture-admin
GITEA_ADMIN_PASSWORD=fixture-admin-pw-change-me
GITEA_ADMIN_EMAIL=fixture-admin@example.com

# Gitea org the repos are migrated into.
GITEA_TARGET_ORG=tinygrad
